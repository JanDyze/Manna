// Cloudflare Workers: serves the built app (dist/) as static files, like Might. Every unknown path gets
// index.html so React Router can handle /plan/bills, /owed/:id and so on. Cache rules: public/_headers.
{
  "name": "manna",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
